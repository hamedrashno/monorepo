{
  "name": "@catalog/api",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "build": "nest build --builder swc --no-type-check",
    "dev": "nest start --watch --builder swc --no-type-check",
    "start": "node dist/main.js",
    "lint": "eslint src/**/*.ts",
    "typecheck": "tsc -p tsconfig.build.json --noEmit --declarationMap false",
    "package": "pnpm build && pnpm pack --pack-destination ../../artifacts/api",
    "clean": "rimraf dist coverage"
  },
  "dependencies": {
    "@catalog/contracts": "workspace:*",
    "@nestjs/common": "^12.1.0",
    "@nestjs/config": "^12.0.1",
    "@nestjs/core": "^12.1.0",
    "@nestjs/platform-express": "^12.1.0",
    "@nestjs/swagger": "^12.0.2",
    "@nestjs/terminus": "^12.1.0",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.15.1",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2"
  },
  "devDependencies": {
    "@catalog/eslint-config": "workspace:*",
    "@catalog/typescript-config": "workspace:*",
    "@nestjs/cli": "^12.0.0",
    "@swc/cli": "^0.8.1",
    "@swc/core": "^1.16.2",
    "@types/express": "^5.0.6",
    "@types/node": "^24.10.0",
    "eslint": "^10.11.0",
    "rimraf": "^6.1.3",
    "typescript": "^5.9.3"
  },
  "files": [
    "dist",
    "Dockerfile",
    "README.md",
    ".env.example"
  ]
}
